{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "requires_user",
    "evidence",
    "changed_files",
    "tests",
    "next_action"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "TOLLGATE_REACHED",
        "STOP_REQUIRED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "requires_user": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  }
}
