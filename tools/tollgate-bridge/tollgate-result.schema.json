{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "requires_user",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SMOKE_OK",
        "WORKSPACE_WRITE_SMOKE_OK"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "requires_user": {
      "type": "boolean",
      "const": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
